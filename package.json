{
  "name": "locus-solo-web",
  "private": true,
  "version": "1.0.0",
  "description": "Jeu solo de placement de polyominos, responsive et tactile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "vitest run",
    "db:create": "wrangler d1 create locus-leaderboard --binding DB --update-config",
    "db:migrate": "wrangler d1 execute locus-leaderboard --remote --file=./migrations/0001_create_scores.sql",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.124.0"
  }
}
